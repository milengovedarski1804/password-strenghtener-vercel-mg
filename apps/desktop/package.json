{
  "name": "@password-checker/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.json",
    "copy:web": "node scripts/copy-web-dist.js",
    "build": "npm run build -w @password-checker/web && npm run copy:web && npm run build:electron",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "bg.uni-plovdiv.fmi.password-checker",
    "productName": "Explainable Password Strength Checker",
    "electronVersion": "32.3.3",
    "files": [
      "dist-electron/**/*",
      "web-dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
